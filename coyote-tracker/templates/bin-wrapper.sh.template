#!/usr/bin/env bash
# Coyote Tracker consumer wrapper — AUTO-GENERATED by tracker-init (COY-342 / COY-T481).
#
# Why this file exists: a Claude Code plugin cannot ship a main `statusLine` or a
# `permissions.allow` entry, and `${CLAUDE_PLUGIN_ROOT}` is NOT expanded inside a
# consumer's own settings. So the consumer needs a script at a STABLE path
# (`.claude/bin/<name>.sh`) that the statusLine command and the allow-list can point
# at. This thin wrapper is that stable path: it delegates to the plugin's real
# script, re-resolving the plugin's (moving) cache location on EVERY call so a plugin
# update never breaks it.
#
# The wrapper selects which plugin script to run from its OWN basename, so all the
# wrappers (statusline.sh, away.sh, worklog-split.sh, carry-over-ack.sh, timer-stop.sh)
# are byte-identical. Commit them — they are consumer-repo files, not plugin files.
#
# NOTE: intentionally NOT `set -e` — the resolver loop relies on test failures as
# control flow, which `set -e` would turn into an early exit.
set -uo pipefail

script="$(basename "$0")"

find_target() {
  # 1. Plugin env present (e.g. invoked from within a plugin hook)? Trust it.
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -x "${CLAUDE_PLUGIN_ROOT}/bin/${script}" ]; then
    printf '%s' "${CLAUDE_PLUGIN_ROOT}/bin/${script}"
    return 0
  fi
  # 2. Resolve from the plugin cache. The cache path changes on every plugin
  #    update, so glob it fresh each call rather than baking an absolute path.
  #    CLAUDE_CONFIG_DIR is inherited from the parent Claude Code process; fall
  #    back to the default install location.
  local base="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins"
  local cand
  for cand in \
    "$base"/marketplaces/*/coyote-tracker/bin/"$script" \
    "$base"/cache/*/coyote-tracker/bin/"$script" \
    "$base"/cache/*/coyote-tracker/*/bin/"$script"; do
    if [ -x "$cand" ]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  return 1
}

if ! target="$(find_target)"; then
  echo "coyote-tracker: could not locate plugin script '${script}' — is the coyote-tracker plugin enabled?" >&2
  exit 127
fi

exec "$target" "$@"
